{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs", "tests/e2e/**/*.ts"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "build/**/*.ts", "tests/**/*.ts"],
  "ignore": ["src/**/*.module.d.css.ts"],
  "ignoreDependencies": ["@fontsource/barlow-condensed"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["openssl"]
}

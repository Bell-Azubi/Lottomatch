{
  "name": "lottomatch-live",
  "version": "1.0.0",
  "private": true,
  "description": "Live draw and display system for the FC Laufenburg-Kaisten Lottomatch, hosted on GitHub Pages.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --strictPort --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "node scripts/css-module-types.mjs --check && eslint . --max-warnings 0 && prettier --check .",
    "lint:knip": "knip",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=visual",
    "test:e2e:perf": "playwright test --project=performance --project=soak --workers=1",
    "budgets": "node scripts/check-budgets.mjs",
    "lhci": "lhci autorun --config=lighthouserc.cjs && LIGHTHOUSE_DEVICE=desktop lhci autorun --config=lighthouserc.cjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "verify": "npm run lint && npm run lint:knip && npm run typecheck && npm run test:coverage && npm run build && npm run budgets",
    "css-types": "node scripts/css-module-types.mjs"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "canvas-confetti": "1.9.4",
    "idb": "8.0.4",
    "papaparse": "5.7.0",
    "preact": "10.29.8",
    "valibot": "1.5.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource/barlow-condensed": "5.3.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/preact": "3.2.6",
    "@testing-library/user-event": "14.6.8",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.10",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1"
  }
}
